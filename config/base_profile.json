{
  "profile_version": "1.0.0",
  "model": {
    "path": "weights/model_imgsz_640/best.onnx",
    "backend": "onnxruntime",
    "providers": [
      "CPUExecutionProvider"
    ],
    "task": "segmentation",
    "input_size": 640,
    "preprocess": {
      "type": "letterbox",
      "normalize": true,
      "color_format": "RGB",
      "padding_value": 114
    },
    "output_format": {
      "type": "yolo_seg_proto",
      "box_format": "xyxy",
      "has_objectness": true,
      "class_encoding": "id",
      "num_classes": 1,
      "num_mask_coeffs": 32
    },
    "model_zoo": {
      "320": "weights/model_imgsz_320/best.onnx",
      "416": "weights/model_imgsz_416/best.onnx",
      "640": "weights/model_imgsz_640/best.onnx"
    },
    "postprocess": {
      "conf_threshold": 0.3,
      "iou_threshold": 0.5,
      "target_class_ids": [
        0
      ],
      "mask_threshold": 0.5,
      "crop_mask_to_bbox": true,
      "min_contour_area": 1.0,
      "contour_mode": "largest"
    }
  },
  "region": {
    "frame_width": 1280,
    "frame_height": 720,
    "roi": {
      "x": 0,
      "y": 0,
      "w": 1280,
      "h": 720
    }
  },
  "collection": {
    "trigger_band": {
      "position_ratio": 0.5,
      "thickness_ratio": 0.2,
      "min_overlap_ratio": 0.1,
      "pending_ttl_frames": 3,
      "allow_inside_band_trigger": true
    },
    "tracker": {
      "type": "centroid",
      "max_jump_px": 80.0,
      "ttl_frames": 10,
      "min_hits": 2,
      "max_reverse_px": 12.0,
      "max_area_ratio_change": 3.0
    },
    "detection_filter": {
      "min_aspect_ratio": 3.0,
      "area_divisor": 50.0
    }
  },
  "inspection": {
    "mode": "auto_baseline",
    "defect_policy": {
      "min_violated_dimensions": 1,
      "score_dimension_count": 2,
      "deadband_ratio": 0.0,
      "deadband_floor": 0.0
    },
    "auto_baseline": {
      "rules_version": "geometry_v1",
      "length_lower_percentile": "p5",
      "length_upper_percentile": "p99",
      "width_lower_percentile": "p1",
      "width_upper_percentile": "p95",
      "length_lower_margin": 0.0,
      "length_upper_margin": 0.09,
      "width_lower_margin": 0.09,
      "width_upper_margin": 0.0,
      "calibration": {
        "min_valid_records": 50,
        "min_inlier_ratio": 0.7,
        "max_outlier_ratio": 0.3,
        "outlier": {
          "modified_z_score_threshold": 3.5,
          "iqr_multiplier": 1.5
        }
      }
    },
    "average_ratio": {
      "width_min_ratio": 0.84,
      "width_max_ratio": 1.06,
      "length_min_ratio": 0.94,
      "length_max_ratio": 1.1
    },
    "vlm": {
      "model": "gpt-5.4",
      "can_mark_normal": false
    }
  }
}
